# ========================================
# YieldHarvest Agent Configuration
# ========================================

# ----- Blockchain Configuration -----
BSC_RPC_URL=https://bsc.drpc.org
BSC_TESTNET_RPC_URL=https://drpc.org/chainlist/bsc-testnet-rpc
OPBNB_RPC_URL=https://opbnb.drpc.org
CHAIN_ID=56

# Private key for deployment (NEVER commit this!)
PRIVATE_KEY=

# ----- Contract Addresses (Fill after deployment) -----
VAULT_MANAGER_ADDRESS=
SESSION_KEY_MANAGER_ADDRESS=
DECISION_LOGGER_ADDRESS=

# ----- Agent Configuration -----
# Minimum APY to consider (in %)
AGENT_MIN_APY=5.0

# Maximum risk score to accept (0-10 scale)
AGENT_MAX_RISK_SCORE=7.0

# How often to compound (seconds) - 14400 = 4 hours
AGENT_COMPOUND_INTERVAL=14400

# APY difference to trigger rebalance (in %)
AGENT_REBALANCE_THRESHOLD=2.0

# Maximum allocation per protocol (in %)
AGENT_MAX_ALLOCATION_PER_PROTOCOL=20.0

# Initial capital to manage (in BNB)
AGENT_INITIAL_CAPITAL=1.0

# ----- Protocol Addresses (BSC Mainnet) -----
# PancakeSwap
PANCAKE_ROUTER=0x10ED43C718714eb63d5aA57B78B54704E256024E
PANCAKE_MASTERCHEF=0xa5f8C5Dbd5F286960b9d90548680aE5ebFf07652
PANCAKE_FACTORY=0xcA143Ce32Fe78f1f7019d7d551a6402fC5350c73

# Venus Protocol
VENUS_COMPTROLLER=0xfD36E2c2a6789Db23113685031d7F16329158384
VENUS_vBNB=0xA07c5b74C9B40447a954e1466938b865b6BBea36
VENUS_vUSDT=0xfD5840Cd36d94D7229439859C0112a4185BC0255

# Thena
THENA_ROUTER=0xd4ae6eCA985340Dd434D38F470aCCce4DC78D109
THENA_VOTER=0x3A1D0952809F4948d15EBCe8d345962A282C4fCb

# Stablecoins
USDT=0x55d398326f99059fF775485246999027B3197955
BUSD=0xe9e7CEA3DedcA5984780Bafc599bD69ADd087D56
USDC=0x8AC76a51cc950d9822D68b83fE1Ad97B32Cd580d

# Wrapped BNB
WBNB=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c

# ----- API Keys -----
# Anthropic Claude API (for AI decision making)
ANTHROPIC_API_KEY=

# BscScan API (for contract verification)
BSCSCAN_API_KEY=
# CoinGecko API (for price data)
COINGECKO_API_KEY=

# ----- Session Key Settings -----
# Session key spending limit (in BNB)
SESSION_KEY_SPENDING_LIMIT=0.1

# Session key expiry (in seconds) - 86400 = 24 hours
SESSION_KEY_EXPIRY=86400

# ----- Safety Settings -----
# Maximum slippage tolerance (in %)
MAX_SLIPPAGE=1.0

# Maximum gas price (in gwei)
MAX_GAS_PRICE=10

# Emergency pause (set to true to stop agent)
EMERGENCY_PAUSE=false

# ----- Dashboard Settings -----
NEXT_PUBLIC_CHAIN_ID=56
NEXT_PUBLIC_RPC_URL=https://bsc.drpc.org
NEXT_PUBLIC_VAULT_ADDRESS=
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# ----- Logging -----
LOG_LEVEL=INFO
LOG_FILE=logs/agent.log

# ----- Development -----
NODE_ENV=production
DEBUG=false
